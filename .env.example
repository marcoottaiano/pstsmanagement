# Public configuration from the official Supabase project Connect dialog.
# Never commit real database passwords, secret keys or service-role keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key required by the protected admin user-management page.
# Prefer the current secret key; the legacy service-role key is also supported.
SUPABASE_SECRET_KEY=

# Public application URL used in invitation and password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
